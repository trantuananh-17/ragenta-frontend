# ragenta-backend. Owns identity (Better Auth at /v1/auth/*), workspaces,
# projects, knowledge bases, chat, billing and usage. Server-side only: the
# browser talks to this app's own /api/* proxy, so the URL never reaches the
# bundle.
RAGENTA_API_URL=https://staging-backend.ragenta.cloud

# This app's own public URL. Better Auth builds the Google OAuth callback and
# the password-reset link from it, so it must match the origin the browser is
# actually on. Read by the browser through window.__env.
APP_BASE_URL=http://localhost:3001

# The marketing site. Pricing, legal pages and the public docs live there.
SITE_BASE_URL=https://staging.ragenta.cloud

# ragenta-backend must list this app's origin in its own TRUSTED_ORIGINS, or
# Better Auth refuses the sign-in and CORS refuses the call:
#   ragenta-backend  TRUSTED_ORIGINS=...,http://localhost:3001
